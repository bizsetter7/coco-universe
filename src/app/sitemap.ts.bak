import { MetadataRoute } from 'next';
import seoRegionsMaster from '@/lib/data/seo_regions_master.json';

export default function sitemap(): MetadataRoute.Sitemap {
    const baseUrl = 'https://cocoalba.kr';

    // 1. Static Pages
    const staticPages = [
        {
            url: baseUrl,
            lastModified: new Date(),
            changeFrequency: 'daily' as const,
            priority: 1.0,
        },
        {
            url: `${baseUrl}/lounge`,
            lastModified: new Date(),
            changeFrequency: 'weekly' as const,
            priority: 0.8,
        },
    ];

    // 2. Dynamic Region Pages (Sampled for build test)
    const regionPages = (seoRegionsMaster as any[]).slice(0, 5).map((region: any) => ({
        url: `${baseUrl}/coco/${region.id}`,
        lastModified: new Date(),
        changeFrequency: 'daily' as const,
        priority: 0.9,
    }));

    return [...staticPages, ...regionPages];
}
