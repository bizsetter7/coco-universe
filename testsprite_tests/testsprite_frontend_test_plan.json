[
  {
    "id": "TC001",
    "title": "Submit inquiry form successfully from /audit",
    "description": "Verifies the inquiry modal opens from the /audit landing page and can be submitted with all required fields to show the success message.",
    "category": "B2B Landing Interaction (Inquiry Form)",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to \"/audit\""
      },
      {
        "type": "action",
        "description": "Click \"도입 문의하기\""
      },
      {
        "type": "assertion",
        "description": "Verify text \"도입 문의하기\" is visible"
      },
      {
        "type": "action",
        "description": "Type \"홍길동\" into the name field"
      },
      {
        "type": "action",
        "description": "Type \"테스트컴퍼니\" into the company field"
      },
      {
        "type": "action",
        "description": "Type \"010-1234-5678\" into the contact field"
      },
      {
        "type": "action",
        "description": "Type \"문의 드립니다. 데모 및 도입 절차를 알고 싶습니다.\" into the message field"
      },
      {
        "type": "action",
        "description": "Click \"Submit\" on the inquiry form"
      },
      {
        "type": "assertion",
        "description": "Verify text \"담당자 연락 예정(1877-1442)\" is visible"
      }
    ]
  },
